# Your Travel CRM — environment configuration
# Copy to .env and fill in real values for each client deployment.
# There are no Supabase or Lovable variables — this app is fully self-hosted.

# --- Database (required) ---
# A dedicated PostgreSQL 16 database for THIS client only (no shared/multi-tenant DB).
DATABASE_URL="postgres://ytc:ytc@postgres:5432/ytc"

# --- Auth (required) ---
# Generate strong random secrets per deployment, e.g.: openssl rand -hex 32
# Never reuse the same secrets across two client deployments.
JWT_SECRET="change-me-generate-a-long-random-secret"
JWT_REFRESH_SECRET="change-me-a-different-long-random-secret"

# --- WhatsApp Cloud API (Meta, official — direct connection, no middleman) ---
# From Meta for Developers -> your WhatsApp Business app.
# Can also be set from the app's Settings -> Integrations screen instead of here.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
# Any string you choose; must match the "Verify token" you enter in Meta's
# webhook setup screen for the GET hub.challenge handshake.
WHATSAPP_VERIFY_TOKEN=""

# --- OpenAI (WhatsApp intent classification) ---
OPENAI_API_KEY=""

# --- SMTP ---
# Not required here: SMTP settings are stored in the database
# (Settings -> Integrations -> outgoing email) so they can be changed without
# a redeploy. Leave unset unless you specifically want an env-var fallback.

# --- Meta Conversions API (ads tracking, optional) ---
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""

# --- Runtime ---
NODE_ENV="production"
PORT="3000"
